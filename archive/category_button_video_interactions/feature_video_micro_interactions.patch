+    // CATEGORY CARD VIDEO MICRO-INTERACTION CONTROLLER
+    // WCAG 2.1 Criterion 2.3.3: Respects prefers-reduced-motion
+    // Snappy, non-blocking, skippable on tap
+    // =========================================================
+    let currentCardAnimationTimeout = null;
+    let animatingCardBtn = null;
+
+    function handleCategoryCardClick(btnElement, navigationAction) {
+      const prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+      // Skip immediately if prefers-reduced-motion is active OR if user taps again
+      if (prefersReducedMotion || (animatingCardBtn && animatingCardBtn === btnElement)) {
+        if (currentCardAnimationTimeout) {
+          clearTimeout(currentCardAnimationTimeout);
+          currentCardAnimationTimeout = null;
+        }
+        resetCardAnimation(animatingCardBtn);
+        animatingCardBtn = null;
+        navigationAction();
+        return;
+      }
+
+      // Reset any previous animation
+      if (animatingCardBtn) {
+        if (currentCardAnimationTimeout) {
+          clearTimeout(currentCardAnimationTimeout);
+          currentCardAnimationTimeout = null;
+        }
+        resetCardAnimation(animatingCardBtn);
+        animatingCardBtn = null;
+      }
+
+      const video = btnElement ? btnElement.querySelector('video') : null;
+      if (!video) {
+        navigationAction();
+        return;
+      }
+
+      animatingCardBtn = btnElement;
+      btnElement.classList.add('animating');
+
+      try {
+        video.currentTime = 0;
+        const playPromise = video.play();
+        if (playPromise !== undefined) {
+          playPromise.catch(err => {
+            console.log('Category card video notice:', err);
+          });
+        }
+      } catch (e) {}
+
+      // Snappy micro-interaction: 560ms
+      currentCardAnimationTimeout = setTimeout(() => {
+        navigationAction();
+        setTimeout(() => {
+          resetCardAnimation(btnElement);
+          if (animatingCardBtn === btnElement) {
+            animatingCardBtn = null;
+          }
+        }, 150);
+        currentCardAnimationTimeout = null;
+      }, 560);
+    }
+
+    function resetCardAnimation(btnElement) {
+      if (!btnElement) return;
+      btnElement.classList.remove('animating');
+      const video = btnElement.querySelector('video');
+      if (video) {
+        try {
+          video.pause();
+          video.currentTime = 0;
+        } catch (e) {}
+      }
+    }
